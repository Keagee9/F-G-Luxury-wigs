/**
 * @fileoverview Firestore Security Rules for Luxe Locks Boutique.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and cart items,
 * while allowing public read access to the product catalog. Write access to products
 * is now allowed for any authenticated user.
 *
 * Data Structure:
 * - /users/{userId}: User profile information. Only the user can read/write their profile.
 * - /products/{productId}: Product catalog. Publicly readable. Any authenticated user can write.
 * - /users/{userId}/cart_items/{cartItemId}: Cart items for a user. Only the user can manage their cart items.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Write access to the product catalog is granted to any authenticated user.
 * - Data consistency between user IDs in the path and the document data is enforced on create and update.
 *
 * Denormalization for Authorization:
 *  - The `cart_items` subcollection relies on path-based authorization, using the `userId` in the path
 *    to determine ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     *    - request.auth.uid: 'user123'
     *    - request.resource.data.id: 'user123'
     * @allow (get) User with ID 'user123' can read their profile.
     *    - request.auth.uid: 'user123'
     * @allow (update) User with ID 'user123' can update their profile.
     *    - request.auth.uid: 'user123'
     * @allow (delete) User with ID 'user123' can delete their profile.
     *    - request.auth.uid: 'user123'
     * @deny (create) User with ID 'user456' attempts to create a profile for 'user123'.
     *    - request.auth.uid: 'user456'
     *    - request.resource.data.id: 'user123'
     * @deny (get) User with ID 'user456' attempts to read the profile of 'user123'.
     *    - request.auth.uid: 'user456'
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn()
                    && isOwner(userId)
                    && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId)
                    && request.resource.data.id == resource.data.id; // Enforce immutability of userId
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to product information. Products are publicly readable.
     * @path /products/{productId}
     * @allow (get) Any user can read product information.
     * @allow (list) Any user can list products.
     * @allow (create) Any signed-in user can create products.
     * @allow (update) Any signed-in user can update products.
     * @allow (delete) Any signed-in user can delete products.
     * @principle Allows public read access and authenticated write access to the product catalog.
     */
    match /products/{productId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to cart items for a specific user.
     * @path /users/{userId}/cart_items/{cartItemId}
     * @allow (create) User with ID 'user123' can create a cart item in their cart.
     *    - request.auth.uid: 'user123'
     *    - request.resource.data.userId: 'user123'
     * @allow (get) User with ID 'user123' can read a cart item in their cart.
     *    - request.auth.uid: 'user123'
     * @allow (update) User with ID 'user123' can update a cart item in their cart.
     *    - request.auth.uid: 'user123'
     * @allow (delete) User with ID 'user123' can delete a cart item in their cart.
     *    - request.auth.uid: 'user123'
     * @deny (create) User with ID 'user456' attempts to create a cart item in the cart of 'user123'.
     *    - request.auth.uid: 'user456'
     *    - request.resource.data.userId: 'user123'
     * @deny (get) User with ID 'user456' attempts to read a cart item in the cart of 'user123'.
     *    - request.auth.uid: 'user456'
     * @principle Enforces document ownership for cart items.
     */
    match /users/{userId}/cart_items/{cartItemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}
